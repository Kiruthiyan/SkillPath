# Backend - Supabase Postgres (URL-encode special chars in password, e.g. @ -> %40)
# Use the Supabase Session pooler URI when the direct host is unavailable:
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

JWT_SECRET=your-jwt-secret-change-in-production
GEMINI_API_KEY=
PORT=5000

# Google OAuth 2.0 Client ID (Google Cloud Console -> Credentials), used to verify Google sign-in
# credentials on the backend. Required for /auth/google and /auth/google/link.
GOOGLE_CLIENT_ID=

# Comma-separated allowed origins for production CORS (e.g. https://your-app.vercel.app)
CORS_ORIGINS=

# Base URL of the deployed frontend, used to build links in invite emails (e.g. https://app.skillpath.ai)
APP_BASE_URL=http://localhost:5173


# SMTP config for sending password-reset OTP emails (required for /auth/forgot-password to
# actually deliver emails; without these set, OTP requests are logged server-side but not sent)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# One-time super admin bootstrap (do not commit real values). Run `npm run seed:super-admin`
# after setting these; the temp password must be changed on first login and is never stored
# in plaintext or logged.
# SUPER_ADMIN_EMAIL=
# SUPER_ADMIN_TEMP_PASSWORD=
