# Deployed backend origin (no trailing slash). Required on Vercel.
# Example: https://skillpath-api.onrender.com
VITE_API_URL=

# Google OAuth Web Client ID (same project as backend GOOGLE_CLIENT_ID).
# Required for Google sign-in on the frontend.
# Add every frontend origin in Google Cloud Console:
#   APIs & Services > Credentials > OAuth 2.0 Client IDs > Authorized JavaScript origins
# Local dev normally needs: http://localhost:5173
# Production needs your exact https:// domain.
VITE_GOOGLE_CLIENT_ID=

# Public site URL — used for og:image, canonical links and structured data.
# Must match the production Vercel domain (no trailing slash).
# Example: https://skill-path-ruby-sigma.vercel.app
VITE_PUBLIC_SITE_URL=
